# HydraDNS public demo — environment variables read by docker-compose.demo.yml.
# Copy to demo/.env and edit before running:
#   cd demo
#   cp .env.example .env
#   docker compose -f docker-compose.demo.yml up -d
# See demo/README.md ("Required .env values" and "TLS and the reverse proxy
# layout") for the full explanation of each variable below.

# Required. The public origin visitors will use, scheme included. Must match
# exactly what's in the browser's address bar (scheme + host), not the
# internal docker hostname. No default — docker compose up fails fast with a
# clear error if this is left unset.
DEMO_PUBLIC_ORIGIN=https://demo.example.com

# Optional. Only set this if you're running a reverse proxy in front of the
# demo (you should — see demo/README.md). Value is that proxy's container
# name or address on the hydra-demo-net network, e.g. "caddy" if you name the
# service that. Leave empty (the default) if you are not running a reverse
# proxy — leaving it empty means the control plane trusts no proxy for
# X-Forwarded-For.
DEMO_TRUSTED_PROXY=

# Optional. Pin a released version instead of tracking :latest.
HYDRA_VERSION=latest
