# HydraDNS Environment Variables

# Image tag pulled by docker-compose.yml (ghcr.io/hydradns/<service>:$HYDRA_VERSION).
# Leave unset to track "latest". Pin to a release, e.g. HYDRA_VERSION=v0.1.0,
# to stay on a known-good version. Has no effect on `docker compose build`.
HYDRA_VERSION=latest

# Core service
HYDRA_CONFIG=/app/configs/config.yaml
HYDRA_DB=/app/data/hydradns.db
HYDRA_POLICIES=/app/configs/policies.json

# CORS (comma-separated origins allowed to call the control plane API).
# Default only allows the dashboard when it's reached as http://localhost:3000.
# Reaching the dashboard via a LAN IP or hostname (e.g. a Raspberry Pi at
# http://192.168.1.53:3000)? Add that exact origin here, comma-separated:
#   CORS_ORIGINS=http://localhost:3000,http://192.168.1.53:3000
# See docs/pi-deployment.md for the full LAN-access walkthrough.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# UI
# WARNING: this value is baked into the dashboard's client JS at build time
# (Next.js NEXT_PUBLIC_* semantics) and does NOT change published images at
# container runtime. It only takes effect if you `docker compose build ui`
# locally with this set. See docs/pi-deployment.md for the LAN implications.
NEXT_PUBLIC_API_URL=http://localhost:8080
