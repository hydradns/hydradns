# HydraDNS Environment Variables

# Image tag pulled by docker-compose.yml (ghcr.io/hydradns/<service>:$HYDRA_VERSION).
# Leave unset to track "latest". Pin to a release, e.g. HYDRA_VERSION=v0.1.0,
# to stay on a known-good version. Has no effect on `docker compose build`.
HYDRA_VERSION=latest

# Core service
HYDRA_CONFIG=/app/configs/config.yaml
HYDRA_DB=/app/data/hydradns.db
HYDRA_POLICIES=/app/configs/policies.json

# CORS (comma-separated origins allowed to call the control plane API).
# This explicit allowlist is checked first. On top of it, the API also
# allows a request whose Origin hostname matches the Host header it was
# reached on (ports ignored) as long as that hostname is an IP literal or
# "localhost" — so opening the dashboard at a LAN IP, e.g.
# http://192.168.1.53:3000, works against http://192.168.1.53:8080 with no
# change here. A named host (e.g. pi.local, hydra.lan, a reverse-proxy
# domain) is not covered by that automatic rule and needs an explicit entry:
#   CORS_ORIGINS=http://localhost:3000,http://hydra.lan:3000
# See docs/pi-deployment.md for the full walkthrough.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Turns off the automatic same-host CORS rule described above. Leave this
# alone unless you have a specific reason to require every origin to be
# listed explicitly in CORS_ORIGINS.
CORS_ALLOW_SAME_HOST=true

# Comma-separated CIDRs/IPs the control plane trusts to set X-Forwarded-For
# for client-IP purposes (the login/setup rate limiter and the RBAC audit
# log). Empty (the default) means no proxy is trusted, so the real socket
# address is always used. Only set this to the address of a reverse proxy
# you control that overwrites (never appends to) X-Forwarded-For — anyone
# who can spoof this header from a trusted range can fake their client IP
# to the throttle and the audit log.
# Note: docker-compose.yml does not currently forward this variable into
# the core container's environment; setting it here only takes effect if
# you add it to that service's `environment:` list yourself, or run the
# controlplane binary directly.
TRUSTED_PROXIES=

# How often the dataplane checks the database for blocklist changes (add,
# toggle, disable, delete, finished download) and rebuilds the in-memory
# blocklist. 0 disables the poll (changes then only take effect on the next
# BLOCKLIST_UPDATE_INTERVAL refresh or a restart). Same compose-wiring note
# as TRUSTED_PROXIES above applies.
BLOCKLIST_POLL_INTERVAL=5s

# Turns this instance into a public, read-only demo: rejects every mutating
# request, seeds a fixed-password demo user and synthetic data, and masks
# client IPs in responses. Not for a normal self-hosted install — see
# demo/README.md and demo/.env.example, which run a separate compose file
# with this already wired in. Same compose-wiring note as TRUSTED_PROXIES
# above applies to the root docker-compose.yml.
HYDRA_DEMO_MODE=false

# Hash (HMAC-SHA256) client IPs before writing them to the query log instead
# of storing them as-is. This is pseudonymisation, not anonymisation: anyone
# who holds both the database and the secret (HYDRA_ANON_SECRET, or the
# generated <data dir>/anon_secret file if that's unset) can brute-force the
# small IPv4 address space back to the original addresses. Off by default —
# per-device visibility in the query log is a core feature of a home/office
# DNS firewall's query log. Same compose-wiring note as TRUSTED_PROXIES above
# applies.
HYDRA_ANONYMIZE_CLIENT_IPS=false
HYDRA_ANON_SECRET=

# UI
# The dashboard derives the API's host from the page's own URL at runtime
# (protocol + hostname, port 8080), so the published image works over a LAN
# IP without a rebuild. Set this only to override that: a reverse proxy, or
# an API reachable on a different host/port than the dashboard. Next.js
# still inlines this value at build time — a runtime env var alone will not
# change it in an already-built image; you'd need to rebuild the UI with it
# set. See docs/pi-deployment.md for the remaining TLS caveat.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Build-time flag to show the DoH-bypass-attempts panel on the dashboard
# (hidden by default). Next.js inlines this at build time like
# NEXT_PUBLIC_API_URL above — a runtime env var alone has no effect on an
# already-built image.
NEXT_PUBLIC_SHOW_BYPASS_PANEL=
